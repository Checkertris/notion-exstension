{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "es6",
    "target": "es6",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src", "test.tsx", "old"],
  "exclude": ["node_modules"]
}
